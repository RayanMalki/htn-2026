# Copy to .env, or export the same variables before running scripts/start.sh.
# Never commit credentials. Compose passes these values to every backend service.
DOMAIN=localhost
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://hypecheck:replace-with-a-long-random-password@db:5432/hypecheck
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data
# Set live when the provider and Elastic credentials below are available.
MODEL_MODE=mock
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL=gpt-4o-mini
# gemini API key (Google AI Studio; verify billing separately from GCP credits)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTIC_INDEX=hypecheck-passages-v2
ELASTIC_INFERENCE_ID=.elser-2-elastic
ELASTIC_SEMANTIC=true
MEDLINEPLUS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.2
RELEASE=hypecheck-local
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
ADMIN_TOKEN=
ENABLE_FAILURE_INJECTION=false
SENTRY_DEMO_ENABLED=false
MAX_ACTIVE_CASES=10
RATE_LIMIT_PER_MINUTE=6
CASE_TIMEOUT_SECONDS=120
RESEARCH_TIMEOUT_SECONDS=35
UPTIME_URL=http://api:8000/healthz
# Optional one-time dashboard provisioning (not required by application runtime).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_ID=
SENTRY_API_BASE=https://sentry.io/api/0
# GPTZero authorship detection over the transcript. Optional; the stage is skipped when unset.
GPTZERO_API_KEY=
# Experimental second reading with speech fillers stripped; costs an extra call.
GPTZERO_FILLER_READING=false

# Narrated portrait fact-check videos (live analysis only; uses OPENAI_API_KEY).
VIDEO_ENABLED=true
VIDEO_ENCODER_PRESET=veryfast
VIDEO_ENCODER_THREADS=2
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# Built into the Docker image; override for host development.
WHISPER_MODEL=/opt/whisper/ggml-base.en.bin

# Optional existing Elastic rerank endpoint. No resource is provisioned by the app.
ELASTIC_RERANK_ENABLED=false
ELASTIC_RERANK_INFERENCE_ID=
ELASTIC_RERANK_TIMEOUT_SECONDS=3
