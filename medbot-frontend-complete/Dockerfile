FROM node:22-alpine AS build
WORKDIR /app
COPY medbot-frontend-complete/package*.json ./
RUN npm ci
COPY medbot-frontend-complete ./
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT
ARG VITE_SENTRY_TRACES_SAMPLE_RATE
ARG VITE_SENTRY_PROFILE_SESSION_SAMPLE_RATE
ARG VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE
ARG VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT \
    VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE \
    VITE_SENTRY_PROFILE_SESSION_SAMPLE_RATE=$VITE_SENTRY_PROFILE_SESSION_SAMPLE_RATE \
    VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=$VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE \
    VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=$VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY infra/Caddyfile /etc/caddy/Caddyfile
