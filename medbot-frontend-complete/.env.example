# Copy to .env.local in this folder for native Vite development.
# Use the React project's DSN, not the backend DSN or an auth token.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1
# Defaults: buffer sessions and upload when an error occurs.
# Temporarily set SESSION_SAMPLE_RATE=1 to verify normal-session recording.
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
