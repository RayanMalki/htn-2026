{$DOMAIN:localhost} {
    encode zstd gzip
    request_body {
        max_size 101MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
    @backend path /api/* /healthz /readyz
    handle @backend {
        reverse_proxy api:8000 {
            flush_interval -1
            transport http {
                response_header_timeout 150s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
